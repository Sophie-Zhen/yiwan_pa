TELEGRAM_BOT_TOKEN=paste_your_token_from_botfather_here
USER_NAME=your_name

# IANA timezone name. Drives both container clock (libc) and JobQueue
# scheduling. Examples: Europe/Dublin, America/New_York, Asia/Shanghai.
TZ=Europe/Dublin

# Reply language for prompts that have no user message to infer from
# (e.g. the scheduled morning digest). For interactive replies, the bot
# matches the language of the user's incoming message regardless of this.
USER_LANGUAGE=Chinese

# Required for scheduled push (find via /id command in chat with the bot).
TELEGRAM_USER_CHAT_ID=

# Daily digest delivery time, in the bot host's local timezone. Format HH:MM.
DIGEST_TIME=08:30

# LLM backend: "claude_code" (default — shells out to claude CLI, uses
# subscription auth) or "anthropic" (uses anthropic SDK + self-written
# agent loop; requires ANTHROPIC_API_KEY below).
LLM_BACKEND=claude_code

# Required only when LLM_BACKEND=anthropic. Get one at
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
GOOGLE_SHEETS_CREDENTIALS=data/credentials/google.json
# Transhipment parcels spreadsheet.
GOOGLE_SHEET_ID=
# 基金定投 (fund SIP) spreadsheet — separate from parcels.
INVESTMENTS_SHEET_ID=
# 家庭花销 (household spending) spreadsheet — separate from the above.
EXPENSES_SHEET_ID=
